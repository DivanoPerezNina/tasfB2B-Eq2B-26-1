# Normaliza line endings: LF en el repo, cada OS usa el suyo al checkout
* text=auto

# Scripts de shell siempre con LF (Linux los ejecuta)
*.sh text eol=lf

# Archivos de texto fuente
*.java text eol=lf
*.go   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.txt  text eol=lf

# Binarios — sin conversión
*.jar  binary
*.exe  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
