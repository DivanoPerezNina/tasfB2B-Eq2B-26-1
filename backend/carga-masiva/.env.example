# ── Carga Masiva — variables de entorno ──────────────────────────────────────
# Copiar a .env y ajustar valores reales (nunca commitear .env)

PORT=8082

DB_HOST=<host-aws-rds-o-ip>
DB_PORT=3306
DB_NAME=tasfb2b
DB_USER=<usuario-bd>
DB_PASS=<contraseña-de-la-bd>

# Directorio temporal donde se guardan los archivos para el Planificador
TEMP_DIR=/tmp/tasf

BATCH_SIZE=1000
MAX_UPLOAD_MB=50
