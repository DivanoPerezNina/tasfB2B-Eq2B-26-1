# ─────────────────────────────────────────────────────────────────────────────
#  TASF.B2B — Variables de entorno
#  Copia este archivo a .env y completa los valores reales.
#  NUNCA subas .env al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (AWS RDS o MySQL local) ─────────────────────────────────────
DB_HOST=<host-aws-rds-o-ip>
DB_PORT=3306
DB_NAME=tasfb2b
DB_USER=admin
DB_PASS=<contraseña-de-la-bd>

# Planificador: usar aeropuertos desde MySQL. Poner txt solo para fallback local.
PLANIFICADOR_AEROPUERTOS_FUENTE=bd

# ── CORS (dominio público de la VM) ──────────────────────────────────────────
CORS_ORIGIN=http://1inf54-984-2b.inf.pucp.edu.pe

# ── URLs internas entre servicios (no cambiar salvo puerto distinto) ──────────
PLANIFICADOR_URL=http://localhost:8084
EJECUTOR_URL=http://localhost:8083
CARGA_MASIVA_URL=http://localhost:8082

# ── Rutas de datos del planificador ──────────────────────────────────────────
# Deben apuntar a donde están los archivos txt en la VM
PLANIFICADOR_RUTA_AEROPUERTOS=/opt/tasfb2b/backend/planificador/datos/aeropuertos.txt
PLANIFICADOR_RUTA_VUELOS=/opt/tasfb2b/backend/planificador/datos/vuelos.txt
PLANIFICADOR_RUTA_ENVIOS=/opt/tasfb2b/backend/planificador/datos/_envios_preliminar_

# ── Fecha inicio del dataset (YYYYMMDD) ───────────────────────────────────────
PLANIFICADOR_FECHA_INICIO=20260101

# ── Parámetros opcionales del ejecutor ───────────────────────────────────────
TICK_INTERVAL_MS=1000
SSE_MAX_CLIENTES=50
